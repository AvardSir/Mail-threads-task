# Скопируйте в .env и укажите CANDIDATE.
CANDIDATE=ivan.petrov@gmail.com

# Для локального запуска вручную (вне docker compose)
PROVIDER_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailthreads?schema=public
REQUEST_TIMEOUT=10000
MAX_RETRIES=5
BASE_DELAY=500
MAX_DELAY=30000
TOTAL_OPERATION_TIMEOUT=600000
LOG_LEVEL=info